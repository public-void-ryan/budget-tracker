{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // A duplicate email is an ordinary 409, but EF logs the unique violation (and the
      // failed command) as errors with stack traces. Unexpected save failures still reach
      // the log as unhandled 500s through ASP.NET's exception handling.
      "Microsoft.EntityFrameworkCore.Update": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*"
}
